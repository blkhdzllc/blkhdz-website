import requests
import json
import os
import base64

# Setup credentials from GitHub Secrets
APP_ID = os.environ['APP_ID']
CERT_ID = os.environ['CERT_ID']
REFRESH_TOKEN = os.environ['REFRESH_TOKEN']

def get_access_token():
    url = "https://api.ebay.com/identity/v1/oauth2/token"
    auth_str = f"{APP_ID}:{CERT_ID}"
    b64_auth = base64.b64encode(auth_str.encode()).decode()
    
    headers = {
        "Content-Type": "application/x-www-form-urlencoded",
        "Authorization": f"Basic {b64_auth}"
    }
    data = {
        "grant_type": "refresh_token",
        "refresh_token": REFRESH_TOKEN
    }
    
    response = requests.post(url, headers=headers, data=data)
    return response.json()['access_token']

def fetch_my_listings(token):
    # This calls the "Finding API" or "Browse API" to get your items
    # For now, let's search specifically for your store's JDM and LEGO sets
    url = "https://api.ebay.com/buy/browse/v1/item_summary/search?q=LEGO&seller=blkhdz"
    headers = {"Authorization": f"Bearer {token}"}
    
    response = requests.get(url, headers=headers)
    return response.json()

# Run the process
token = get_access_token()
inventory = fetch_my_listings(token)

# Save to your website's data folder
with open('data/inventory.json', 'w') as f:
    json.dump(inventory, f, indent=2)
